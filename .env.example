# Скопируйте в .env на сервере и заполните: cp .env.example .env

# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=

# Куда слать заявки: ID чата, группы или канала (несколько — через запятую)
TELEGRAM_CHAT_ID=

# Необязательно: свой адрес Bot API (прокси), если api.telegram.org недоступен с сервера
# TELEGRAM_API_URL=https://api.telegram.org
